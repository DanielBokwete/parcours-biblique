{
 "cleanUrls": true,
 "headers": [
  {
   "source": "/seed/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-store"
    }
   ]
  },
  {
   "source": "/sw.js",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  },
  {
   "source": "/version.json",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-store"
    }
   ]
  },
  {
   "source": "/download/(.*)",
   "headers": [
    {
     "key": "Content-Type",
     "value": "application/vnd.android.package-archive"
    },
    {
     "key": "Content-Disposition",
     "value": "attachment"
    }
   ]
  }
 ]
}